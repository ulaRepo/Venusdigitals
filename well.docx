                            <td class="px-4 py-3.5">
                                <span class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full bg-info-light text-info">
    1
</span>
                            </td>
                            <td class="px-4 py-3.5">
                                <span class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full bg-surface-alt text-content-secondary">
    1
</span>
                            </td>
                            <td class="px-4 py-3.5 text-right">
                                <button @click="$dispatch('open-delete-cat-modal-1')" class="px-3 py-1 text-xs font-medium rounded-lg bg-danger-light text-danger hover:bg-danger hover:text-primary-foreground transition-colors">Delete</button>
                            </td>
                        </tr>

                        
                        <div x-data="{ open: false }"
     @open-delete-cat-modal-1.window="open = true"
     x-show="open" x-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center p-4">
    
    <div x-show="open" x-transition.opacity class="absolute inset-0 bg-surface-overlay/60" @click="open = false"></div>
    
    <div x-show="open" x-transition class="relative w-full max-w-lg bg-surface-card rounded-2xl shadow-xl overflow-hidden">
        
                    <div class="px-6 py-4 border-b border-border flex items-center justify-between">
