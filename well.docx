/* â•â• THEME â•â• */
let isDarkMode = true;
function applyTheme(darkMode){
  isDarkMode = !!darkMode;
  document.body.classList.toggle('light-mode', !isDarkMode);
  const themeToggle = document.getElementById('themeToggle');
  if(themeToggle) themeToggle.classList.toggle('on', isDarkMode);
  const themeModeText = document.getElementById('themeModeText');
  if(themeModeText) themeModeText.textContent = isDarkMode ? 'Always on' : 'Light mode enabled';
}
function toggleTheme(){
  applyTheme(!isDarkMode);
  localStorage.setItem('rwg_theme', isDarkMode ? 'dark' : 'light');
}

/* â•â• PAGE NAVIGATION â€” redirects in multi-page app â•â• */
const PAGE_ROUTES = {
    'trade':    '/dashboard/trade',
    'markets':  '/dashboard/markets',
    'assets':   '/dashboard/portfolio',
    'deposits': '/dashboard/deposits',
    'dashboard':'/dashboard',
    'convert':  '/dashboard/convert',
};
function goPage(id, el){ window.location.href = PAGE_ROUTES[id] || ('/dashboard/' + id); return false; }
function openDepositSheet(){ window.location.href = '/dashboard/deposits'; }
function closeDepositSheet(){ window.location.href = '/dashboard'; }
function openWithdrawSheet(){ window.location.href = '/dashboard/withdraw-funds'; }
function closeWithdrawSheet(){ window.location.href = '/dashboard'; }
