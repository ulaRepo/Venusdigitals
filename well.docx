      <div style="background:rgba(74,108,247,.04);border:1px solid rgba(0, 62, 204, 1);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-trophy" style="color:var(--blue2);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">Top Performer</div><div style="font-size:.64rem;color:#444">Ranked elite</div></div></div>
      <div style="background:rgba(245,197,66,.04);border:1px solid rgba(245,197,66,.12);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-lock" style="color:var(--ylw);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">Funds Protected</div><div style="font-size:.64rem;color:#444">Capital secured</div></div></div>
      <div style="background:rgba(0,212,154,.04);border:1px solid rgba(0,212,154,.12);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-clock" style="color:var(--acc);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">24/7 Active</div><div style="font-size:.64rem;color:#444">Always trading</div></div></div>
    </div>
    <button onclick="closeTraderView();startCopyTrading('${t.name.replace(/'/g,"\\'")}'')" style="width:100%;padding:13px;border-radius:12px;border:none;background:linear-gradient(135deg,var(--blue),#3B7BFF);color:#fff;font-family:'DM Sans',sans-serif;font-weight:600;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px"><i class="fa-solid fa-copy"></i> Copy This Trader</button>
  `;
  document.getElementById('traderViewBg').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeTraderView(){ document.getElementById('traderViewBg').classList.remove('open'); document.body.style.overflow = ''; }
function handleTraderViewClick(e){ if(e.target === document.getElementById('traderViewBg')) closeTraderView(); }
function startCopyTrading(name){
  document.getElementById('copySuccessName').textContent = name;
  document.getElementById('copySuccessBg').classList.add('open');
  document.body.style.overflow = 'hidden';
  triggerNotification('Copy Trading Started!', 'You are now copying ' + name + '. Trades will be mirrored automatically.');
}
function closeCopySuccess(){
  document.getElementById('copySuccessBg').classList.remove('open');
  document.body.style.overflow = '';
  window.location.href = window.PAGES.dashboard;
}

/* â•â• CT LOCK (default â€” redirects; copytrading.php overrides this) â•â• */
function closeCopyTradingLock(){
  const el = document.getElementById('ctLockBg');
  if(el){ el.classList.remove('open'); document.body.style.overflow = ''; }
}
function handleCtLockBgClick(e){ if(e.target === document.getElementById('ctLockBg')) closeCopyTradingLock(); }
function copyCTLockAddr(){
  const addr = document.getElementById('ctLockAddr')?.textContent;
  if(addr){ copyTxt(addr); }
  const btn = document.getElementById('ctLockCopyBtn');
  if(btn){ btn.textContent = 'COPIED!'; btn.style.color = 'var(--grn)'; setTimeout(()=>{ btn.textContent='COPY'; btn.style.color='#fff'; }, 2500); }
}

/* â•â• BROWSER PUSH NOTIFICATIONS â•â• */
function triggerNotification(title, body){
  if(!('Notification' in window)) return;
  if(Notification.permission === 'granted'){
    const n = new Notification(title, {
      body: body,
      icon: 'https://api.qrserver.com/v1/create-qr-code/?size=64x64&data=ZenNestMarkets',
      badge: 'https://api.qrserver.com/v1/create-qr-code/?size=32x32&data=ZNM',
      tag: 'znm-' + Date.now(),
    });
    setTimeout(() => n.close(), 6000);
  } else if(Notification.permission !== 'denied'){
    Notification.requestPermission().then(perm => { if(perm === 'granted') triggerNotification(title, body); });
  }
}

