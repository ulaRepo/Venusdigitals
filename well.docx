        <button @click="mobileSidebar = false" class="lg:hidden text-sidebar-muted hover:text-content-inverse">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    
    <div class="px-4 py-4 border-b border-sidebar-border shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-primary text-primary-foreground text-xs font-medium flex items-center justify-center shrink-0">
                AC
            </div>
            <div class="min-w-0">
                <p class="text-sm font-medium text-sidebar-text truncate">Admin Control</p>
                <p class="text-xs text-sidebar-muted">Super Admin</p>
            </div>
        </div>
    </div>

    
    <nav class="flex-1 overflow-y-auto py-3">

        
        <p class="px-6 pt-4 pb-2 text-[0.65rem] font-semibold text-sidebar-muted uppercase tracking-widest">Main</p>

