    <main class="transition-all duration-200 lg:ml-64 pt-16 min-h-screen">
        
        <div x-data="{ toasts: [] }"
             x-init="
                                             "
             class="fixed top-20 right-4 z-50 space-y-2 w-80">
            <template x-for="toast in toasts" :key="toast.id">
                <div x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="translate-x-full opacity-0"
                     x-transition:enter-end="translate-x-0 opacity-100"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="translate-x-0 opacity-100"
                     x-transition:leave-end="translate-x-full opacity-0"
                     :class="{
                        'bg-success-light border-success text-success': toast.type === 'success',
                        'bg-danger-light border-danger text-danger': toast.type === 'error',
                        'bg-warning-light border-warning text-warning': toast.type === 'warning',
                     }"
                     class="border rounded-lg p-4 flex items-start gap-3 shadow-lg">
                    <span x-text="toast.message" class="text-sm flex-1"></span>
                    <button @click="toasts = toasts.filter(t => t.id !== toast.id)" class="shrink-0 opacity-60 hover:opacity-100">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </template>
        </div>

        <div class="p-4 lg:p-6 space-y-6">
            <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold text-content tracking-tight">Edit Card #4</h1>
                    <p class="mt-1 text-sm text-content-secondary">Modify card credentials and status</p>
            </div>
            <div class="flex items-center gap-3">
            <a href="https://digital-grownt.com/admin/admin/cards/4"
               class="bg-surface-alt text-content border border-border hover:bg-border rounded-lg px-4 py-2 text-sm font-medium transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
                Back to Card
            </a>
        </div>
    </div>

        
    <div class="max-w-2xl">
        <div class="bg-surface-card rounded-xl border border-border shadow-card p-6">
    <div class="mb-5 pb-4 border-b border-border">
                <p class="text-sm text-content-muted">Editing card for <span class="font-medium text-content">Gilmar Lopez</span> — Virtual Mastercard</p>
            </div>

            <form action="https://digital-grownt.com/admin/admin/cards/4" method="POST" class="space-y-5">
                <input type="hidden" name="_token" value="5HgeEAY2xYAIf7TtJSt6KYllMvNyOcywDzOKVMxc"> <input type="hidden" name="_method" value="PUT">
                <div class="">
            <label  for="card_holder"  class="block text-sm font-medium text-content mb-1.5">
            Card Holder Name
                            <span class="text-danger">*</span>
                    </label>
        <input type="text" id="card_holder" name="card_holder"
                           value="Gilmar Lopez"
                           class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                           required>
        </div>

                <div class="">
            <label  for="card_number"  class="block text-sm font-medium text-content mb-1.5">
            Card Number
                    </label>
        <input type="text" id="card_number" name="card_number"
                           value=""
                           class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content font-mono focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                           placeholder="e.g. 4111 1111 1111 1111" maxlength="25">
                    <p class="text-xs text-content-muted mt-1">Leave blank to keep existing value.</p>
        </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="">
            <label  for="expiry_month"  class="block text-sm font-medium text-content mb-1.5">
            Expiry Month (MM)
                    </label>
        <input type="text" id="expiry_month" name="expiry_month"
                               value=""
                               class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                               placeholder="01" maxlength="2">
        </div>

                    <div class="">
            <label  for="expiry_year"  class="block text-sm font-medium text-content mb-1.5">
            Expiry Year (YYYY)
                    </label>
        <input type="text" id="expiry_year" name="expiry_year"
                               value=""
                               class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                               placeholder="2029" maxlength="4">
        </div>
                </div>

                <div class="">
            <label  for="cvv"  class="block text-sm font-medium text-content mb-1.5">
            CVV
                    </label>
        <input type="text" id="cvv" name="cvv"
                           value=""
                           class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content font-mono focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                           placeholder="123" maxlength="4">
        </div>

                <div class="">
            <label  for="balance"  class="block text-sm font-medium text-content mb-1.5">
            Balance ($)
                            <span class="text-danger">*</span>
                    </label>
        <input type="number" step="0.01" min="0" id="balance" name="balance"
                           value="0.00"
                           class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                           required>
        </div>

                <div class="">
            <label  for="status"  class="block text-sm font-medium text-content mb-1.5">
            Status
                            <span class="text-danger">*</span>
                    </label>
        <select id="status" name="status"
                            class="w-full bg-surface-card border border-border rounded-lg px-3.5 py-2.5 text-sm text-content focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                            required>
                                                    <option value="pending" selected>Pending</option>
                                                    <option value="active" >Active</option>
                                                    <option value="frozen" >Frozen</option>
                                                    <option value="cancelled" >Cancelled</option>
                                                    <option value="rejected" >Rejected</option>
                                            </select>
        </div>

                
                <div class="flex gap-3 pt-2">
                    <button type="submit"
                            class="bg-primary text-primary-foreground hover:bg-primary-hover rounded-lg px-5 py-2.5 text-sm font-medium transition-colors">
                        Save Changes
                    </button>
                    <a href="https://digital-grownt.com/admin/admin/cards/4"
                       class="bg-surface-alt text-content border border-border hover:bg-border rounded-lg px-5 py-2.5 text-sm font-medium transition-colors">
                        Cancel
                    </a>
                </div>
            </form>
</div>
    </div>
