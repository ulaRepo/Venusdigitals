var tvW=null,tvT=null;
const tvCfg=(sym,cid,hide)=>({autosize:true,symbol:sym,interval:'60',timezone:'Etc/UTC',theme:'dark',style:'1',locale:'en',toolbar_bg:'#111',enable_publishing:false,hide_top_toolbar:hide||false,save_image:false,container_id:cid,overrides:{'paneProperties.background':'#000','paneProperties.backgroundType':'solid','scalesProperties.textColor':'#333','mainSeriesProperties.candleStyle.upColor':'#00d47c','mainSeriesProperties.candleStyle.downColor':'#ff4560','mainSeriesProperties.candleStyle.borderUpColor':'#00d47c','mainSeriesProperties.candleStyle.borderDownColor':'#ff4560','mainSeriesProperties.candleStyle.wickUpColor':'#00d47c','mainSeriesProperties.candleStyle.wickDownColor':'#ff4560'}});
