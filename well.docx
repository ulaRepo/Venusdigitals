/* â•â• TABS â•â• */
function switchTab(id,el){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('on'));
  document.querySelectorAll('.tab-body').forEach(t=>t.classList.remove('on'));
  el.classList.add('on');
