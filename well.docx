  const t = TRADERS_DATA[idx];
  document.getElementById('traderViewTitle').textContent = t.name;
  const perfBar = (pct) => {
    const w = Math.min(parseFloat(pct), 100);
    return `<div style="flex:1;height:6px;border-radius:99px;background:#1a1a1a;overflow:hidden"><div style="height:100%;width:${w}%;border-radius:99px;background:var(--grn)"></div></div>`;
