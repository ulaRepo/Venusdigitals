</div>
    
    
    <div>
    </div>    <div>
            <div x-data="{ show: true }" x-show="show" x-transition
             x-init="setTimeout(() => show = false, 6000)"
             role="alert" aria-live="polite"
             class="flex items-start gap-[10px] rounded-[9px] px-[12px] py-[10px] mb-[9px]"
             style="background:rgba(0,212,124,.10);border:1px solid rgba(0,212,124,.35);box-shadow:0 0 0 1px rgba(0,212,124,.06), 0 8px 24px -12px rgba(0,212,124,.45);">
            <i class="fa-solid fa-circle-check mt-[2px] flex-shrink-0" style="color:#00d47c;font-size:.82rem;"></i>
            <p class="flex-1" style="color:#00d47c;font-size:.82rem;line-height:1.55;font-weight:500;">Trust Wallet connected successfully!</p>
            <button @click="show = false" class="flex-shrink-0 transition-opacity hover:opacity-100 opacity-60" style="color:#00d47c;">
                <i class="fa-solid fa-xmark text-[.8rem]"></i>
            </button>
        </div>
    </div>
    <div>
    </div>
    
    <div x-data="walletConnect()" class="inner-page">

        
        <div class="inner-hdr">
            <div class="inner-back" onclick="history.back()"><i class="fa-solid fa-chevron-left"></i></div>
            <div>
                <div class="inner-title">Wallet Connect</div>
                <p class="text-[.72rem] text-[#444] mt-0.5">Manage your connected cryptocurrency wallets</p>
            </div>
        </div>

        <div class="space-y-[9px]">

            
            <div class="bg-[#111] border border-[#1e1e1e] rounded-[13px] overflow-hidden">
                <div class="flex items-center justify-between p-[15px] border-b border-[#1e1e1e]">
                    <div class="flex items-center gap-3">
                        <div class="w-[38px] h-[38px] rounded-[10px] bg-[#1a1a1a] flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-wallet text-blue2 text-[.9rem]"></i>
                        </div>
                        <div>
                            <p class="text-[.88rem] font-medium text-[#fff]">My Connected Wallets</p>
                            <p class="text-[.72rem] text-[#555]" x-text="(connectedList.length) + ' of ' + maxSlots + ' slots used'">0 of 10 slots used</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-1.5">
                        <template x-for="i in maxSlots" :key="i">
                            <div class="w-2 h-2 rounded-full" :class="i <= connectedList.length ? 'bg-[#4a6cf7]' : 'bg-[#2a2a2a]'"></div>
                        </template>
                    </div>
                </div>

                                                                                    <template x-if="loadingWallets">
