        <span style="font-size:.8rem;color:#555">Win Rate</span>
        <div style="display:flex;align-items:center;gap:10px">${perfBar(t.winrate)}<span style="font-weight:700;color:var(--grn);font-size:.85rem;min-width:42px;text-align:right">${t.winrate}%</span></div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">ROI</span><span style="font-weight:700;color:var(--grn)">${t.roi}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Total Trades</span><span style="font-weight:600">${t.trades}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Wins</span><span style="font-weight:600;color:var(--grn)">${t.wins}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Losses</span><span style="font-weight:600;color:var(--red)">${t.losses}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Profit Share</span><span style="font-weight:600;color:var(--ylw)">${t.profit}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Min. Startup</span><span style="font-weight:600;color:var(--blue2)">${t.min}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Risk Level</span><span style="font-weight:600">${t.risk}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px"><span style="font-size:.8rem;color:#555">Markets</span><span style="font-weight:600;font-size:.78rem;color:#888">${t.markets}</span></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px">
      <div style="background:rgba(0,212,124,.04);border:1px solid rgba(0,212,124,.12);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-shield-halved" style="color:var(--grn);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">Verified Trader</div><div style="font-size:.64rem;color:#444">Identity confirmed</div></div></div>
      <div style="background:rgba(74,108,247,.04);border:1px solid rgba(0, 62, 204, 1);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-trophy" style="color:var(--blue2);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">Top Performer</div><div style="font-size:.64rem;color:#444">Ranked elite</div></div></div>
      <div style="background:rgba(245,197,66,.04);border:1px solid rgba(245,197,66,.12);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-lock" style="color:var(--ylw);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">Funds Protected</div><div style="font-size:.64rem;color:#444">Capital secured</div></div></div>
      <div style="background:rgba(0,212,154,.04);border:1px solid rgba(0,212,154,.12);border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px"><i class="fa-solid fa-clock" style="color:var(--acc);font-size:.85rem"></i><div><div style="font-size:.74rem;font-weight:500">24/7 Active</div><div style="font-size:.64rem;color:#444">Always trading</div></div></div>
    </div>
    <button onclick="closeTraderView();startCopyTrading('${t.name.replace(/'/g,"\\'")}'')" style="width:100%;padding:13px;border-radius:12px;border:none;background:linear-gradient(135deg,var(--blue),#3B7BFF);color:#fff;font-family:'DM Sans',sans-serif;font-weight:600;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px"><i class="fa-solid fa-copy"></i> Copy This Trader</button>
  `;
  document.getElementById('traderViewBg').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeTraderView(){ document.getElementById('traderViewBg').classList.remove('open'); document.body.style.overflow = ''; }
function handleTraderViewClick(e){ if(e.target === document.getElementById('traderViewBg')) closeTraderView(); }
function startCopyTrading(name){
  document.getElementById('copySuccessName').textContent = name;
  document.getElementById('copySuccessBg').classList.add('open');
  document.body.style.overflow = 'hidden';
  triggerNotification('Copy Trading Started!', 'You are now copying ' + name + '. Trades will be mirrored automatically.');
}
function closeCopySuccess(){
  document.getElementById('copySuccessBg').classList.remove('open');
  document.body.style.overflow = '';
  window.location.href = window.PAGES.dashboard;
}

/* â•â• CT LOCK (default â€” redirects; copytrading.php overrides this) â•â• */
function closeCopyTradingLock(){
  const el = document.getElementById('ctLockBg');
  if(el){ el.classList.remove('open'); document.body.style.overflow = ''; }
}
function handleCtLockBgClick(e){ if(e.target === document.getElementById('ctLockBg')) closeCopyTradingLock(); }
function copyCTLockAddr(){
  const addr = document.getElementById('ctLockAddr')?.textContent;
  if(addr){ copyTxt(addr); }
  const btn = document.getElementById('ctLockCopyBtn');
  if(btn){ btn.textContent = 'COPIED!'; btn.style.color = 'var(--grn)'; setTimeout(()=>{ btn.textContent='COPY'; btn.style.color='#fff'; }, 2500); }
}

/* â•â• BROWSER PUSH NOTIFICATIONS â•â• */
function triggerNotification(title, body){
  if(!('Notification' in window)) return;
  if(Notification.permission === 'granted'){
    const n = new Notification(title, {
      body: body,
      icon: 'https://api.qrserver.com/v1/create-qr-code/?size=64x64&data=ZenNestMarkets',
      badge: 'https://api.qrserver.com/v1/create-qr-code/?size=32x32&data=ZNM',
      tag: 'znm-' + Date.now(),
    });
    setTimeout(() => n.close(), 6000);
  } else if(Notification.permission !== 'denied'){
    Notification.requestPermission().then(perm => { if(perm === 'granted') triggerNotification(title, body); });
  }
}

/* â•â• PROPERTY GALLERY â•â• */
const PROPS = [{"name":"Luxury Miami Condo","loc":"Miami, FL Â· USA","val":"$2,400,000","roi":"12.4%","tokens":"4,200","desc":"A stunning beachfront condo with panoramic ocean views. Features open-plan living, smart home technology and resort-style amenities.","beds":3,"baths":2,"sqft":"2,100","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/1438832/pexels-photo-1438832.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/1080721/pexels-photo-1080721.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Master Bed","img":"https://images.pexels.com/photos/164595/pexels-photo-164595.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bathroom","img":"https://images.pexels.com/photos/2507016/pexels-photo-2507016.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Pool","img":"https://images.pexels.com/photos/261327/pexels-photo-261327.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"Dubai Marina Villa","loc":"Dubai Â· UAE","val":"$3,600,000","roi":"14.2%","tokens":"7,200","desc":"An ultra-luxury villa in the heart of Dubai Marina. Floor-to-ceiling windows, private pool and direct marina access.","beds":5,"baths":4,"sqft":"4,800","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/1732414/pexels-photo-1732414.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1643383/pexels-photo-1643383.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/2062426/pexels-photo-2062426.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Master Bed","img":"https://images.pexels.com/photos/271624/pexels-photo-271624.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bathroom","img":"https://images.pexels.com/photos/1909791/pexels-photo-1909791.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Pool","img":"https://images.pexels.com/photos/221457/pexels-photo-221457.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"London Office Tower","loc":"London Â· UK","val":"$8,900,000","roi":"9.8%","tokens":"18,000","desc":"Grade-A commercial tower in central London. Long-term blue-chip tenants, excellent transport links and stunning city views.","beds":0,"baths":6,"sqft":"12,400","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/325185/pexels-photo-325185.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Lobby","img":"https://images.pexels.com/photos/271624/pexels-photo-271624.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Office Floor","img":"https://images.pexels.com/photos/1181406/pexels-photo-1181406.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Meeting Room","img":"https://images.pexels.com/photos/1181395/pexels-photo-1181395.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Rooftop","img":"https://images.pexels.com/photos/2816499/pexels-photo-2816499.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"City View","img":"https://images.pexels.com/photos/460672/pexels-photo-460672.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"New York Penthouse","loc":"Manhattan, NY Â· USA","val":"$12,500,000","roi":"8.6%","tokens":"25,000","desc":"Iconic Manhattan penthouse with 360-degree skyline views. Private terrace, chef kitchen and full concierge service.","beds":4,"baths":3,"sqft":"3,600","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/2224037/pexels-photo-2224037.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1457842/pexels-photo-1457842.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/2089698/pexels-photo-2089698.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Master Bed","img":"https://images.pexels.com/photos/775219/pexels-photo-775219.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Terrace","img":"https://images.pexels.com/photos/1029599/pexels-photo-1029599.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Skyline View","img":"https://images.pexels.com/photos/466685/pexels-photo-466685.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"Bali Beach Resort","loc":"Seminyak, Bali","val":"$1,800,000","roi":"17.5%","tokens":"3,600","desc":"A tropical paradise resort steps from the Indian Ocean. Private villas, infinity pool and lush garden surroundings.","beds":6,"baths":6,"sqft":"5,200","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/261102/pexels-photo-261102.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Area","img":"https://images.pexels.com/photos/2090644/pexels-photo-2090644.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/1599791/pexels-photo-1599791.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bedroom","img":"https://images.pexels.com/photos/1838554/pexels-photo-1838554.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Infinity Pool","img":"https://images.pexels.com/photos/2373201/pexels-photo-2373201.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Beach View","img":"https://images.pexels.com/photos/1174732/pexels-photo-1174732.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"Paris City Apartment","loc":"Paris Â· France","val":"$950,000","roi":"11.2%","tokens":"1,900","desc":"Elegant Haussmann-style apartment in the 7th arrondissement. High ceilings, herringbone floors and Eiffel Tower views.","beds":2,"baths":2,"sqft":"1,400","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/532826/pexels-photo-532826.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1643384/pexels-photo-1643384.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/1556682/pexels-photo-1556682.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bedroom","img":"https://images.pexels.com/photos/262048/pexels-photo-262048.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bathroom","img":"https://images.pexels.com/photos/1910472/pexels-photo-1910472.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Eiffel View","img":"https://images.pexels.com/photos/338515/pexels-photo-338515.jpeg?auto=compress&cs=tinysrgb&w=700"}]}];

let propCurrent=0, propPhotoIdx=0;

function openPropertyGallery(idx){
  propCurrent=idx; propPhotoIdx=0;
  const p=PROPS[idx];
  document.getElementById('propGalleryTitle').textContent=p.name;
  document.getElementById('propGalleryDesc').textContent=p.desc;
  const stats=[{lbl:'Value',val:p.val,color:'var(--blue2)'},{lbl:'APY Return',val:p.roi,color:'var(--grn)'},{lbl:'Tokens',val:p.tokens,color:'#fff'}];
  document.getElementById('propGalleryStats').innerHTML=stats.map(s=>`<div style="background:var(--c1);border:1px solid var(--bd);border-radius:10px;padding:12px;text-align:center"><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:.95rem;color:${s.color}">${s.val}</div><div style="font-size:.65rem;color:#444;margin-top:3px;text-transform:uppercase;letter-spacing:.06em">${s.lbl}</div></div>`).join('');
  const meta=[];
  if(p.beds>0)meta.push(['fa-solid fa-bed',p.beds+' Bedrooms']);
  meta.push(['fa-solid fa-bath',p.baths+' Bathrooms']);
  meta.push(['fa-solid fa-ruler-combined',p.sqft+' sqft']);
  meta.push(['fa-solid fa-location-dot',p.loc]);
  document.getElementById('propGalleryMeta').innerHTML=meta.map(([ico,val],i,arr)=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;${i<arr.length-1?'border-bottom:1px solid #161616;':''}font-size:.81rem"><span style="color:#444;display:flex;align-items:center;gap:7px"><i class="${ico}"></i></span><span style="font-weight:500">${val}</span></div>`).join('');
  renderPropPhoto();
  renderPropThumbs();
  document.getElementById('propGalleryBg').classList.add('open');
  document.body.style.overflow='hidden';
}

function renderPropPhoto(){
  const p=PROPS[propCurrent];
  const room=p.rooms[propPhotoIdx];
  const img=document.getElementById('propMainImg');
  img.style.opacity='0';
  setTimeout(()=>{img.src=room.img;img.style.opacity='1';},150);
  document.getElementById('propRoomLbl').textContent=room.label;
  document.getElementById('propPhotoCount').textContent=(propPhotoIdx+1)+' / '+p.rooms.length;
}

function renderPropThumbs(){
  const p=PROPS[propCurrent];
  document.getElementById('propThumbs').innerHTML=p.rooms.map((r,i)=>`<div onclick="propPhotoIdx=${i};renderPropPhoto();renderPropThumbs()" style="width:60px;height:60px;border-radius:10px;overflow:hidden;border:2px solid ${i===propPhotoIdx?'var(--blue2)':'#1a1a1a'};cursor:pointer;flex-shrink:0;transition:border-color .15s"><img src="${r.img}" alt="${r.label}" style="width:100%;height:100%;object-fit:cover" loading="lazy"/></div>`).join('');
}

function prevPropPhoto(){propPhotoIdx=propPhotoIdx>0?propPhotoIdx-1:PROPS[propCurrent].rooms.length-1;renderPropPhoto();renderPropThumbs();}
function nextPropPhoto(){propPhotoIdx=(propPhotoIdx+1)%PROPS[propCurrent].rooms.length;renderPropPhoto();renderPropThumbs();}
function closePropertyGallery(){document.getElementById('propGalleryBg').classList.remove('open');document.body.style.overflow='';}
function handlePropGalleryBgClick(e){if(e.target===document.getElementById('propGalleryBg'))closePropertyGallery();}

/* â•â• DOMCONTENTLOADED â•â• */
document.addEventListener('DOMContentLoaded',()=>{
  const savedTheme = localStorage.getItem('rwg_theme');
  applyTheme(savedTheme !== 'light');
  if(document.getElementById('tv_chart_container'))
    setTimeout(()=>initMainChart('COINBASE:BTCUSD'),400);
  if(document.getElementById('tv_trade_chart'))
    setTimeout(initTradeChart,400);
  initRotatingTestis();
  if('Notification' in window && Notification.permission === 'default'){
    setTimeout(() => Notification.requestPermission().catch(()=>{}), 3000);
  }
});
</script>


</body>
</html>

