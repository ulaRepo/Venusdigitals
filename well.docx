  document.getElementById('ctWalletBg').classList.add('open');
}
function closeCopyTradeWallet(e){
  if(e.target === document.getElementById('ctWalletBg'))
    document.getElementById('ctWalletBg').classList.remove('open');
}
function copyCTWallet(){
  copyTxt(CT_WALLET_ADDR);
  const btn = document.querySelector('.ct-wallet-copy');
  btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
  btn.style.background = 'rgba(0,212,124,.15)';
  btn.style.borderColor = 'rgba(0,212,124,.3)';
  btn.style.color = 'var(--grn)';
  setTimeout(()=>{btn.innerHTML='<i class="fa-regular fa-copy"></i> Copy';btn.style.background='';btn.style.borderColor='';btn.style.color='';},2500);
}

