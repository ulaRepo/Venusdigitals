  btn.style.borderColor = 'rgba(0,212,124,.3)';
  btn.style.color = 'var(--grn)';
  setTimeout(()=>{btn.innerHTML='<i class="fa-regular fa-copy"></i> Copy';btn.style.background='';btn.style.borderColor='';btn.style.color='';},2500);
}

