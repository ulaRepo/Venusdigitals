              <span class="notif-dot" id="notifBadge" style="width:auto;height:auto;min-width:16px;padding:0 4px;border-radius:8px;font-size:.6rem;line-height:14px;color:#fff;text-align:center;font-weight:700;top:-2px;right:-2px">2</span>
