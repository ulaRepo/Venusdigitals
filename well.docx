function loadTV(sym,lbl,up,el){
  document.querySelectorAll('.pair-pill').forEach(p=>p.classList.remove('on'));
  if(el) el.classList.add('on');
  const tvLbl = document.getElementById('tvLbl');
  if(tvLbl) tvLbl.textContent = lbl;
  const tvBadge = document.getElementById('tvBadge');
  if(tvBadge) tvBadge.className='tv-badge '+(up?'up':'dn');
  initMainChart(sym);
}
