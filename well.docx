<!-- â•â• NOTIFICATION PANEL â•â• -->
<div class="notif-page" id="notifPanel">
  <div class="h-[54px] flex items-center justify-between px-4 bg-black border-b border-[#111] flex-shrink-0">
    <button class="flex items-center gap-[6px] text-white text-[.88rem] cursor-pointer bg-transparent border-none py-[6px] px-1" onclick="closeNotifPage()"><i class="fa-solid fa-chevron-left"></i></button>
    <div class="font-semibold text-[.95rem] text-white">Notifications</div>
    <button class="w-[30px] h-[30px] rounded-full bg-[#1a1a1a] border-none text-[#888] text-[.8rem] flex items-center justify-center cursor-pointer" onclick="closeNotifPage()"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="flex-1 overflow-y-auto" id="notifScroll">
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;min-height:60vh;text-align:center;padding:40px 20px;color:#222">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" style="margin-bottom:16px;opacity:.2">
        <rect x="8" y="14" width="20" height="16" rx="3" stroke="#888" stroke-width="2.5"/>
        <path d="M8 22h20M14 30v6M22 30v6" stroke="#888" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M32 8l4 4-4 4" stroke="#888" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="36" y="34" width="20" height="16" rx="3" stroke="#888" stroke-width="2.5"/>
        <path d="M36 42h20M42 50v6M50 50v6" stroke="#888" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <div style="font-size:.9rem;color:#333;font-weight:500">No notifications yet.</div>
      <div style="font-size:.76rem;color:#222;margin-top:6px">You're all caught up!</div>
    </div>
  </div>
  <div class="px-4 py-3 border-t border-[#111] flex-shrink-0 bg-black">
    <button onclick="markRead()" style="width:100%;padding:12px;border-radius:10px;border:1px solid #1e1e1e;background:transparent;color:#444;font-family:'DM Sans',sans-serif;font-size:.84rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px">
      <i class="fa-solid fa-check-double"></i> Mark all as read
    </button>
  </div>
</div>


<div class="pt-[54px] min-h-screen bg-black" id="main-content">

    <div class="w-full overflow-hidden rounded-[13px] border border-[#1e1e1e] bg-[#111] mb-[14px]">
