/* â•â• THEME â•â• */
let isDarkMode = true;
function applyTheme(darkMode){
  isDarkMode = !!darkMode;
  document.body.classList.toggle('light-mode', !isDarkMode);
  const themeToggle = document.getElementById('themeToggle');
  if(themeToggle) themeToggle.classList.toggle('on', isDarkMode);
  const themeModeText = document.getElementById('themeModeText');
  if(themeModeText) themeModeText.textContent = isDarkMode ? 'Always on' : 'Light mode enabled';
}
function toggleTheme(){
  applyTheme(!isDarkMode);
  localStorage.setItem('rwg_theme', isDarkMode ? 'dark' : 'light');
}

/* â•â• PAGE NAVIGATION â€” redirects in multi-page app â•â• */
const PAGE_ROUTES = {
    'trade':    '/dashboard/trade',
    'markets':  '/dashboard/markets',
    'assets':   '/dashboard/portfolio',
    'deposits': '/dashboard/deposits',
    'dashboard':'/dashboard',
    'convert':  '/dashboard/convert',
};
function goPage(id, el){ window.location.href = PAGE_ROUTES[id] || ('/dashboard/' + id); return false; }
function openDepositSheet(){ window.location.href = '/dashboard/deposits'; }
function closeDepositSheet(){ window.location.href = '/dashboard'; }
function openWithdrawSheet(){ window.location.href = '/dashboard/withdraw-funds'; }
function closeWithdrawSheet(){ window.location.href = '/dashboard'; }
function openCopyTradingLock(){ window.location.href = '/dashboard/copy-trading'; }

/* â•â• SIDEBAR â•â• */
function openSb(){document.getElementById('sidebar').classList.add('open');document.getElementById('overlay').classList.add('open');}
function closeSb(){document.getElementById('sidebar').classList.remove('open');document.getElementById('overlay').classList.remove('open');}

/* â•â• TABS â•â• */
function switchTab(id,el){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('on'));
  document.querySelectorAll('.tab-body').forEach(t=>t.classList.remove('on'));
  el.classList.add('on');
  document.getElementById('tb-'+id).classList.add('on');
  if(id==='overview')setTimeout(()=>initMainChart('COINBASE:BTCUSD'),300);
}

/* â•â• TRADINGVIEW â•â• */
var tvW=null,tvT=null;
const tvCfg=(sym,cid,hide)=>({autosize:true,symbol:sym,interval:'60',timezone:'Etc/UTC',theme:'dark',style:'1',locale:'en',toolbar_bg:'#111',enable_publishing:false,hide_top_toolbar:hide||false,save_image:false,container_id:cid,overrides:{'paneProperties.background':'#000','paneProperties.backgroundType':'solid','scalesProperties.textColor':'#333','mainSeriesProperties.candleStyle.upColor':'#00d47c','mainSeriesProperties.candleStyle.downColor':'#ff4560','mainSeriesProperties.candleStyle.borderUpColor':'#00d47c','mainSeriesProperties.candleStyle.borderDownColor':'#ff4560','mainSeriesProperties.candleStyle.wickUpColor':'#00d47c','mainSeriesProperties.candleStyle.wickDownColor':'#ff4560'}});
function initMainChart(sym){if(tvW){try{tvW.remove();}catch(e){}}tvW=new TradingView.widget(tvCfg(sym,'tv_chart_container',false));}
function initTradeChart(){if(tvT){try{tvT.remove();}catch(e){}}tvT=new TradingView.widget(tvCfg('COINBASE:BTCUSD','tv_trade_chart',true));}

function loadTV(sym,lbl,up,el){
  document.querySelectorAll('.pair-pill').forEach(p=>p.classList.remove('on'));
  if(el) el.classList.add('on');
  const tvLbl = document.getElementById('tvLbl');
  if(tvLbl) tvLbl.textContent = lbl;
  const tvBadge = document.getElementById('tvBadge');
  if(tvBadge) tvBadge.className='tv-badge '+(up?'up':'dn');
  initMainChart(sym);
}
function selPair(el,sym){el.parentNode.querySelectorAll('.pair-pill').forEach(p=>p.classList.remove('on'));el.classList.add('on');if(tvT){try{tvT.remove();}catch(e){}}tvT=new TradingView.widget(tvCfg(sym,'tv_trade_chart',true));}

/* â•â• BALANCE TOGGLE â•â• */
let balHid=false; const realBal = (typeof USER_BAL_FMT !== 'undefined') ? USER_BAL_FMT : ('$' + USER_BAL.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}));
function toggleBal(){balHid=!balHid;const v=balHid?'\u2022\u2022\u2022\u2022\u2022\u2022':realBal;const bf=document.getElementById('balFig');const tb=document.getElementById('topBal');const ei=document.getElementById('eyeIco');if(bf)bf.textContent=v;if(tb)tb.textContent=v;if(ei)ei.className=balHid?'fa-regular fa-eye':'fa-regular fa-eye-slash';}

/* â•â• LIVE PRICE FLICKER â•â• */
const mP=[],mR=[];
function flickerPrices(){
  if(mP.length===0){
    for(let i=0;i<32;i++){
      const el=document.getElementById('mp-'+i)||document.getElementById('mmp-'+i);
      if(!el)break;
      const v=parseFloat((el.textContent||'').replace(/[^0-9.\-]/g,''))||0;
      mP.push(v); mR.push(Math.max(v*0.001,0.01));
    }
    if(mP.length===0)return;
  }
  mP.forEach((p,i)=>{
    mP[i]+=(Math.random()-.5)*mR[i]*.3;
    const v=mP[i];
    const f='$'+v.toLocaleString('en-US',{minimumFractionDigits:v>=1?2:4,maximumFractionDigits:v>=1?2:4});
    ['mp-','mmp-'].forEach(pfx=>{const el=document.getElementById(pfx+i);if(el){el.textContent=f;el.classList.add('pf');setTimeout(()=>el.classList.remove('pf'),250);}});
  });
}
setInterval(flickerPrices,2800);

