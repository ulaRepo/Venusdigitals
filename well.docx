created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"},{"id":59,"external_id":"STOXX50E","name":"EURO STOXX 50","symbol":"STOXX50E","asset_class":"index","price":4982.76,"price_change_24h":null,"price_change_pct_24h":0.28,"high_24h":null,"low_24h":null,"volume_24h":null,"market_cap":null,"logo_url":"https:\/\/logo.clearbit.com\/stoxx.com","data_source":"twelvedata","is_active":true,"created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"},{"id":55,"external_id":"FTSE","name":"FTSE 100","symbol":"FTSE","asset_class":"index","price":7722.55,"price_change_24h":null,"price_change_pct_24h":-0.18,"high_24h":null,"low_24h":null,"volume_24h":null,"market_cap":null,"logo_url":"https:\/\/logo.clearbit.com\/lseg.com","data_source":"twelvedata","is_active":true,"created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"},{"id":58,"external_id":"HSI","name":"Hang Seng Index","symbol":"HSI","asset_class":"index","price":16529.48,"price_change_24h":null,"price_change_pct_24h":-0.73,"high_24h":null,"low_24h":null,"volume_24h":null,"market_cap":null,"logo_url":"https:\/\/logo.clearbit.com\/hsi.com.hk","data_source":"twelvedata","is_active":true,"created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"},{"id":53,"external_id":"IXIC","name":"NASDAQ Composite","symbol":"IXIC","asset_class":"index","price":16274.94,"price_change_24h":null,"price_change_pct_24h":0.82,"high_24h":null,"low_24h":null,"volume_24h":null,"market_cap":null,"logo_url":"https:\/\/logo.clearbit.com\/nasdaq.com","data_source":"twelvedata","is_active":true,"created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"},{"id":57,"external_id":"N225","name":"Nikkei 225","symbol":"N225","asset_class":"index","price":39688.94,"price_change_24h":null,"price_change_pct_24h":1.12,"high_24h":null,"low_24h":null,"volume_24h":null,"market_cap":null,"logo_url":"https:\/\/logo.clearbit.com\/nikkei.com","data_source":"twelvedata","is_active":true,"created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"},{"id":52,"external_id":"SPX","name":"S\u0026P 500","symbol":"SPX","asset_class":"index","price":5175.27,"price_change_24h":null,"price_change_pct_24h":0.56,"high_24h":null,"low_24h":null,"volume_24h":null,"market_cap":null,"logo_url":"https:\/\/logo.clearbit.com\/spglobal.com","data_source":"twelvedata","is_active":true,"created_at":"2026-03-11T17:40:37.000000Z","updated_at":"2026-03-11T18:45:40.000000Z"}],
        filteredAssets: [],
        init() { this.filterAssets(); },
        filterAssets() {
            this.filteredAssets = this.allAssets.filter(a => a.asset_class === this.filterClass);
            if (this.selectedAssetId && !this.filteredAssets.find(a => a.id == this.selectedAssetId)) {
                this.selectedAssetId = ''; this.selectedAsset = null;
            }
        },
        onAssetChange() {
            const id = parseInt(this.selectedAssetId);
            this.selectedAsset = this.allAssets.find(a => a.id === id) || null;
            if (this.selectedAsset) this.updateChart(this.selectedAsset);
        },
        updateChart(asset) {
            let s = asset.symbol.toUpperCase().replace(/\//g,'').replace(/-/g,'').replace(/\s+/g,'');
            let tv = '';
            if (asset.asset_class==='crypto') { if (!s.endsWith('USDT')) s+='USDT'; tv='BINANCE:'+s; }
            else if (asset.asset_class==='forex') tv='FX:'+s;
            else if (asset.asset_class==='index') tv='TVC:'+s;
            else if (asset.asset_class==='etf')   tv='AMEX:'+s;
            else tv='NASDAQ:'+s;
            initChart(tv);
        },
        formatPrice(price) {
            if (!price) return '0.00';
            price = parseFloat(price);
            if (price >= 1) return price.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
            if (price >= 0.01) return price.toFixed(4);
            return price.toFixed(6);
        },
        confirmTrade(action) {
            if (!this.selectedAssetId) {
                Swal.fire({
                    html: `<div style="text-align:center;padding:8px 0">
                        <div style="width:48px;height:48px;border-radius:50%;background:rgba(74,108,247,.12);border:1px solid rgba(74,108,247,.25);display:flex;align-items:center;justify-content:center;margin:0 auto 14px">
                            <svg width="22" height="22" fill="none" stroke="#4a6cf7" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        </div>
                        <div style="color:#fff;font-size:15px;font-weight:600;margin-bottom:6px">Select an Asset</div>
                        <div style="color:#555;font-size:13px">Please choose an asset before placing a trade.</div>
                    </div>`,
                    background:'#111', position:'center', showConfirmButton:true,
                    confirmButtonText:'OK', confirmButtonColor:'#4a6cf7',
                    customClass:{popup:'swal-dark-popup',confirmButton:'swal-dark-btn'}
                });
                return;
            }
            if (!this.amount || this.amount <= 0) {
                Swal.fire({
                    html: `<div style="text-align:center;padding:8px 0">
                        <div style="width:48px;height:48px;border-radius:50%;background:rgba(74,108,247,.12);border:1px solid rgba(74,108,247,.25);display:flex;align-items:center;justify-content:center;margin:0 auto 14px">
                            <svg width="22" height="22" fill="none" stroke="#4a6cf7" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        </div>
                        <div style="color:#fff;font-size:15px;font-weight:600;margin-bottom:6px">Enter Amount</div>
                        <div style="color:#555;font-size:13px">Please enter a valid trade amount.</div>
                    </div>`,
                    background:'#111', position:'center', showConfirmButton:true,
                    confirmButtonText:'OK', confirmButtonColor:'#4a6cf7',
                    customClass:{popup:'swal-dark-popup',confirmButton:'swal-dark-btn'}
                });
                return;
            }
            const modeLabel = this.isDemo ? ' · DEMO' : '';
            const typeLabel = this.tradeType === 'binary' ? 'Binary' : 'Spot';
            const profitLoss = (this.amount * this.leverage / 100).toFixed(2);
            const cs = '$';
            const isBuy = action === 'buy';
            const accentColor = isBuy ? '#00d47c' : '#ff4560';
            const accentBg   = isBuy ? 'rgba(0,212,124,.1)' : 'rgba(255,69,96,.1)';
            const accentBd   = isBuy ? 'rgba(0,212,124,.25)' : 'rgba(255,69,96,.25)';
            const icon       = isBuy ? '↑' : '↓';
            const durLabel   = this.tradeType==='binary'
                ? this.durationOptions.find(d=>d.value===this.duration)?.label ?? '—'
                : 'No expiry';

            Swal.fire({
                html: `
                <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:4px 0">
                  <!-- action badge -->
                  <div style="display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:18px">
                    <div style="width:42px;height:42px;border-radius:50%;background:${accentBg};border:1px solid ${accentBd};display:flex;align-items:center;justify-content:center;font-size:18px;color:${accentColor};font-weight:700">${icon}</div>
                    <div style="text-align:left">
                      <div style="color:#fff;font-size:15px;font-weight:700;letter-spacing:.01em">Confirm ${action.toUpperCase()} ${typeLabel}${modeLabel}</div>
                      <div style="color:#555;font-size:12px;margin-top:2px">${this.selectedAsset.symbol} &mdash; ${this.selectedAsset.name}</div>
                    </div>
                  </div>
                  <!-- rows -->
                  <div style="background:#0d0d0d;border:1px solid #1e1e1e;border-radius:11px;overflow:hidden;margin-bottom:14px">
                    <div style="display:flex;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #1a1a1a">
                      <span style="color:#444;font-size:12px">Entry Price</span>
                      <span style="color:#fff;font-size:12px;font-weight:600">${cs}${this.formatPrice(this.selectedAsset.price)}</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #1a1a1a">
                      <span style="color:#444;font-size:12px">Amount</span>
                      <span style="color:#fff;font-size:12px;font-weight:600">${cs}${Number(this.amount).toFixed(2)}</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #1a1a1a">
                      <span style="color:#444;font-size:12px">Leverage</span>
                      <span style="color:#6e8efb;font-size:12px;font-weight:700">${this.leverage}x</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #1a1a1a">
                      <span style="color:#444;font-size:12px">Duration</span>
                      <span style="color:#fff;font-size:12px">${durLabel}</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px">
                      <span style="color:#444;font-size:12px">Potential P/L</span>
                      <div>
                        <span style="color:#00d47c;font-size:12px;font-weight:700">+${cs}${profitLoss}</span>
                        <span style="color:#333;margin:0 4px;font-size:12px">/</span>
                        <span style="color:#ff4560;font-size:12px;font-weight:700">-${cs}${profitLoss}</span>
                      </div>
                    </div>
                  </div>
                  ${this.isDemo ? '<div style="background:rgba(245,197,66,.07);border:1px solid rgba(245,197,66,.18);border-radius:8px;padding:8px 12px;color:#f5c542;font-size:11px;text-align:center;margin-bottom:2px">Demo Mode — no real funds used</div>' : ''}
                </div>`,
                background: '#111',
                position: 'center',
                showCancelButton: true,
                confirmButtonText: `${icon} ${action.toUpperCase()} Now`,
                cancelButtonText: 'Cancel',
                customClass: {
                    popup:         'swal-dark-popup',
                    confirmButton: 'swal-dark-confirm',
                    cancelButton:  'swal-dark-cancel',
                    actions:       'swal-dark-actions'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    this.$refs.tradeAction.value = action;
                    document.getElementById('tradeForm').submit();
                }
            });

            // Patch confirm button color after render (customClass can't bind runtime vars)
            setTimeout(() => {
                const btn = document.querySelector('.swal-dark-confirm');
                if (btn) btn.style.background = accentColor;
                if (btn && !isBuy) btn.style.color = '#fff';
            }, 0);
        }
    };
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const countdowns = document.querySelectorAll('.trade-countdown');
    if (!countdowns.length) return;
    setInterval(function() {
        countdowns.forEach(function(el) {
            const diff = new Date(el.dataset.expires).getTime() - Date.now();
            if (diff <= 0) {
                el.textContent = 'Settling...';
                el.style.color = '#f5c542';
                if (!el.dataset.processing) {
                    el.dataset.processing = 'true';
                    fetch("/user/dashboard/trades/process", {
                        method:'POST',
                        headers:{'Content-Type':'application/json',},
                        body:JSON.stringify({trade_id: el.dataset.tradeId})
                    }).then(r=>r.json()).then(data=>{ if(data.success) setTimeout(()=>location.reload(),1500); });
                }
                return;
            }
            const h=Math.floor(diff/3600000), m=Math.floor((diff%3600000)/60000), s=Math.floor((diff%60000)/1000);
            el.textContent = (h>0?h+'h ':'')+m+'m '+s+'s';
        });
    }, 1000);
});
</script>

<script>
function requestCloseSpot(tradeId) {
    Swal.fire({
        html: `<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;text-align:center;padding:4px 0">
            <div style="width:46px;height:46px;border-radius:50%;background:rgba(255,69,96,.1);border:1px solid rgba(255,69,96,.25);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:19px;color:#ff4560">↓</div>
            <div style="color:#fff;font-size:15px;font-weight:700;margin-bottom:7px">Request Close?</div>
            <div style="color:#555;font-size:13px;line-height:1.6">This will send a close request to admin.<br>Your trade will be settled at current price.</div>
        </div>`,
        background: '#111',
        position: 'center',
        showCancelButton: true,
        confirmButtonText: 'Yes, Request Close',
        cancelButtonText: 'Cancel',
        customClass: {
            popup: 'swal-dark-popup',
            confirmButton: 'swal-dark-confirm',
            cancelButton: 'swal-dark-cancel',
            actions: 'swal-dark-actions'
        },
        buttonsStyling: false
    }).then((result) => {
        if (result.isConfirmed) {
            fetch("/user/dashboard/trades/request-close", {
                method:'POST',
                headers:{'Content-Type':'application/json',},
                body:JSON.stringify({trade_id:tradeId})
            }).then(r=>r.json()).then(data=>{
                if (data.success) {
                    Swal.fire({
                        html:`<div style="text-align:center;padding:8px 0"><div style="color:#00d47c;font-size:32px;margin-bottom:10px">✓</div><div style="color:#fff;font-size:15px;font-weight:700;margin-bottom:6px">Submitted</div><div style="color:#555;font-size:13px">${data.message}</div></div>`,
                        background:'#111',confirmButtonText:'OK',confirmButtonColor:'#00d47c',
                        customClass:{popup:'swal-dark-popup',confirmButton:'swal-dark-confirm',actions:'swal-dark-actions'},buttonsStyling:false
                    }).then(()=>location.reload());
                } else {
                    Swal.fire({
                        html:`<div style="text-align:center;padding:8px 0"><div style="color:#ff4560;font-size:32px;margin-bottom:10px">✕</div><div style="color:#fff;font-size:15px;font-weight:700;margin-bottom:6px">Error</div><div style="color:#555;font-size:13px">${data.message}</div></div>`,
                        background:'#111',confirmButtonText:'OK',confirmButtonColor:'#ff4560',
                        customClass:{popup:'swal-dark-popup',confirmButton:'swal-dark-confirm',actions:'swal-dark-actions'},buttonsStyling:false
                    });
                }
            });
        }
    });
    setTimeout(()=>{ const b=document.querySelector('.swal-dark-confirm'); if(b){b.style.background='#ff4560';b.style.color='#fff';} },0);
}
</script>


<script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
<script src="../js/convert/config.js"></script>
