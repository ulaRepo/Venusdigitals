          <span style="display:inline-flex;align-items:center;gap:3px;background:rgba(74,108,247,.15);border:1px solid rgba(0, 62, 204, 1);border-radius:20px;padding:2px 8px;font-size:.62rem;font-weight:700;color:var(--blue2)"><i class="fa-solid fa-circle-check"></i> VERIFIED</span>
        </div>
        <div style="font-size:.74rem;color:#444">${t.handle}</div>
        <div style="font-size:.72rem;color:#555;margin-top:2px"><i class="fa-solid fa-users" style="margin-right:4px"></i>${t.followers} Followers</div>
