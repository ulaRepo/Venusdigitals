g":"https://images.pexels.com/photos/221457/pexels-photo-221457.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"London Office Tower","loc":"London Â· UK","val":"$8,900,000","roi":"9.8%","tokens":"18,000","desc":"Grade-A commercial tower in central London. Long-term blue-chip tenants, excellent transport links and stunning city views.","beds":0,"baths":6,"sqft":"12,400","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/325185/pexels-photo-325185.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Lobby","img":"https://images.pexels.com/photos/271624/pexels-photo-271624.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Office Floor","img":"https://images.pexels.com/photos/1181406/pexels-photo-1181406.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Meeting Room","img":"https://images.pexels.com/photos/1181395/pexels-photo-1181395.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Rooftop","img":"https://images.pexels.com/photos/2816499/pexels-photo-2816499.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"City View","img":"https://images.pexels.com/photos/460672/pexels-photo-460672.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"New York Penthouse","loc":"Manhattan, NY Â· USA","val":"$12,500,000","roi":"8.6%","tokens":"25,000","desc":"Iconic Manhattan penthouse with 360-degree skyline views. Private terrace, chef kitchen and full concierge service.","beds":4,"baths":3,"sqft":"3,600","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/2224037/pexels-photo-2224037.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1457842/pexels-photo-1457842.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/2089698/pexels-photo-2089698.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Master Bed","img":"https://images.pexels.com/photos/775219/pexels-photo-775219.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Terrace","img":"https://images.pexels.com/photo